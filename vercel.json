{
  "buildCommand": "pnpm --filter ./artifacts/movie-tracker run build",
  "outputDirectory": "artifacts/movie-tracker/dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "headers": [
    {
      "source": "/.well-known/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
