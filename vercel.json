{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "echo 'Build handled by @vercel/node'",
  "functions": {
    "artifacts/api-server/api/index.ts": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/artifacts/api-server/api/index.ts" }
  ]
}
