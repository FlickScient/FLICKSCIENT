// ─── Background Memory Updater ────────────────────────────────────────────────
async function updateUserMemory(
  supabase      : any,
  hashedUserId  : string,
  userMessage   : string,
  aiResponse    : string,
  existingMemory: UserMemory,
  apiKey        : string,
  memoryRefCount: number
) {
  const extractionPrompt = `
You are a taste extraction engine for a cinema AI. Analyze the exchange below.

User said   : "${userMessage}"
AI responded: "${aiResponse}"

Current profile : ${JSON.stringify(existingMemory.taste_profile || {})}
Current summary : ${existingMemory.conversation_summary || 'None'}

Return ONLY a valid raw JSON object. No markdown. No explanation. No text outside the JSON.
{
  "updated_taste_profile": {
    "favorite_genres"   : [],
    "loved_movies"      : [],
    "disliked_movies"   : [],
    "favorite_directors": [],
    "favorite_actors"   : [],
    "favorite_composers": [],
    "mood_patterns"     : [],
    "viewing_style"     : ""
  },
  "updated_summary" : "2-3 sentences on evolving taste",
  "detected_name"   : null
}
`

  const controller = new AbortController()
  const timeoutId  = setTimeout(() => controller.abort(), 15000)

  try {
    const extractRes = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`,
      {
        method : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify({
          contents        : [{ parts: [{ text: extractionPrompt }] }],
          generationConfig: { temperature: 0.1, maxOutputTokens: 600 },
        }),
        signal: controller.signal,
      }
    )

    clearTimeout(timeoutId)

    if (!extractRes.ok) {
      console.warn(`[FlickScient] Memory extraction API ${extractRes.status}`)
      return
    }

    const extractData = await extractRes.json()
    const rawText     = extractData.candidates?.[0]?.content?.parts?.[0]?.text
    if (!rawText) return

    // JSON Shield: strip all text outside { } boundaries
    const jsonMatch = rawText.match(/\{[\s\S]*\}/)
    if (!jsonMatch) {
      console.warn('[FlickScient] JSON Shield: no valid JSON found in extraction response')
      return
    }

    const extracted = safeJsonParse(jsonMatch[0], null)
    if (!extracted?.updated_taste_profile) {
      console.warn('[FlickScient] Extracted data invalid or missing taste_profile')
      return
    }

    // Merge instead of overwrite
    const mergedTaste = mergeTasteProfiles(existingMemory.taste_profile, extracted.updated_taste_profile)

    const upsertPayload: Record<string, any> = {
      user_id_hash          : hashedUserId,
      taste_profile         : mergedTaste,
      conversation_summary  : extracted.updated_summary || existingMemory.conversation_summary,
      updated_at            : new Date().toISOString(),
      memory_reference_count: memoryRefCount,
    }

    // Only set name if freshly detected and not already stored
    if (extracted.detected_name && !existingMemory.name) {
      upsertPayload.name = extracted.detected_name
    }

    // Probabilistic name cooldown tracking
    if (Math.random() < MAX_NAME_FREQUENCY) {
      upsertPayload.last_name_used_at = Date.now()
    }

    // FIX 2 — await on every DB write
    const { error: upsertError } = await supabase
      .from('flickscient_users')
      .upsert(upsertPayload, { onConflict: 'user_id_hash' })

    if (upsertError) {
      console.error('[FlickScient] Supabase upsert failed:', upsertError.message, upsertError.code)
    } else {
      console.log('[FlickScient] Memory updated for:', hashedUserId)
    }

  } catch (e: any) {
    clearTimeout(timeoutId)
    if (e.name === 'AbortError') {
      console.warn('[FlickScient] Memory update timed out (background — non-critical)')
      return
    }
    console.error('[FlickScient] Memory update error:', e)
  }
}
