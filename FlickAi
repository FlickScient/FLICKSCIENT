// ─── Build Extraction Prompt (v2.1) ───────────────────────────────────────────
function buildExtractionPrompt(
  userMessage   : string,
  aiResponse    : string,
  existingMemory: UserMemory
): string {
  return `
You are a precision taste extraction engine. Clinical. No personality needed.

Analyze this exchange:
USER: "${userMessage}"
AI  : "${aiResponse}"

Existing profile : ${JSON.stringify(existingMemory.taste_profile || {})}
Existing summary : ${existingMemory.conversation_summary || 'None'}

Extract signal. Ignore noise. If the user mentioned, implied, reacted to, or revealed
anything about their taste — capture it. If nothing new was revealed, return existing profile unchanged.

Name: only extract if the user explicitly stated their own name. Null otherwise. Never guess.
Viewing style options: "solo deep-focus", "social watch party", "background comfort", "mixed"

Return ONLY raw JSON. Zero markdown. Zero explanation. Zero text outside the object.

{
  "updated_taste_profile": {
    "favorite_genres": [],
    "loved_movies": [],
    "disliked_movies": [],
    "favorite_directors": [],
    "favorite_actors": [],
    "favorite_composers": [],
    "mood_patterns": [],
    "viewing_style": ""
  },
  "updated_summary": "2-3 sentences. What kind of film person are they? What do they actually want from cinema?",
  "detected_name": null
}`.trim()
}

// ─── Main Handler ─────────────────────────────────────────────────────────────
serve(async (req) => {

  if (req.method === 'OPTIONS') {
    return new Response('ok', { headers: corsHeaders })
  }

  try {
    const body       = await req.json()
    const rawInput   = body.prompt || body.message || 'Yo'
    const userPrompt = sanitizeInput(rawInput)
    const rawUserId  = body.userId || null

    const apiKey = Deno.env.get('GEMINI_API_KEY')
    const sbUrl  = Deno.env.get('SUPABASE_URL')
    const sbKey  = Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')

    if (!apiKey)     throw new Error('GEMINI_API_KEY missing')
    if (!userPrompt) throw new Error('Empty prompt after sanitization')

    let hashedUserId: string | null = null
    if (rawUserId) {
      hashedUserId = await hashUserId(rawUserId)
      console.log('[FlickScient] hashedUserId:', hashedUserId)
    } else {
      console.log('[FlickScient] Anonymous request')
    }

    // Load memory
    let userMemory: UserMemory | null = null
    let supabase: any = null

    if (hashedUserId && sbUrl && sbKey) {
      supabase = createClient(sbUrl, sbKey)
      const { data, error } = await supabase
        .from('flickscient_users')
        .select('name, taste_profile, conversation_summary, last_name_used_at, memory_reference_count, is_creator')
        .eq('user_id_hash', hashedUserId)
        .maybeSingle()

      if (error) {
        console.error('[FlickScient] DB fetch error:', error.message)
      } else {
        userMemory = data ?? null
      }
    }

    // Identity flags
    const isVerifiedMahid      = userMemory?.is_creator === true
    const isImposter           = claimsMahidIdentity(userPrompt) && !isVerifiedMahid
    const spoilerMode          = detectSpoilerIntent(userPrompt)
    const userAskingAboutMahid = mentionsMahid(userPrompt)

    // Build system prompt dynamically
    const systemPrompt = buildSystemPrompt(userMemory, isVerifiedMahid, isImposter, spoilerMode, userAskingAboutMahid)

    // Call Gemini
    const controller = new AbortController()
    const timeoutId  = setTimeout(() => controller.abort(), REQUEST_TIMEOUT)

    let geminiRes: Response
    try {
      geminiRes = await fetch(
        `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash-latest:generateContent?key=${apiKey}`,
        {
          method : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body   : JSON.stringify({
            contents         : [{ parts: [{ text: userPrompt }] }],
            systemInstruction: { parts: [{ text: systemPrompt }] },
            generationConfig : {
              temperature    : 1.05,
              topP           : 0.97,
              topK           : 50,
              maxOutputTokens: 2048,
            },
            safetySettings: [
              { category: 'HARM_CATEGORY_HARASSMENT',        threshold: 'BLOCK_ONLY_HIGH' },
              { category: 'HARM_CATEGORY_HATE_SPEECH',       threshold: 'BLOCK_ONLY_HIGH' },
              { category: 'HARM_CATEGORY_SEXUALLY_EXPLICIT', threshold: 'BLOCK_ONLY_HIGH' },
              { category: 'HARM_CATEGORY_DANGEROUS_CONTENT', threshold: 'BLOCK_ONLY_HIGH' },
            ],
          }),
          signal: controller.signal,
        }
      )
    } catch (e: any) {
      clearTimeout(timeoutId)
      if (e.name === 'AbortError') {
        return new Response(
          JSON.stringify({ message: "Brain's buffering 🛠️ Give me a sec and hit me again." }),
          { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
        )
      }
      throw e
    }

    clearTimeout(timeoutId)

    if (!geminiRes.ok) {
      const errText = await geminiRes.text()
      console.error(`[FlickScient] Gemini ${geminiRes.status}:`, errText)

      if (geminiRes.status === 429) {
        let msg = "My cinematic brain is cooked from requests 🧊 Give me 60 seconds to reset."
        try {
          const errDump = JSON.stringify(JSON.parse(errText)).toLowerCase()
          if (errDump.includes('per_day') || errDump.includes('requests_per_day')) {
            const now = new Date(), reset = new Date()
            reset.setUTCHours(8, 0, 0, 0)
            if (reset <= now) reset.setUTCDate(reset.getUTCDate() + 1)
            const h = Math.ceil((reset.getTime() - now.getTime()) / 3600000)
            msg = `Daily cinema quota maxed 📽️ Brain resets in ~${h}h. Come back then — I'll be ready.`
          } else if (errDump.includes('tpm') || errDump.includes('tokens_per_minute')) {
            msg = "Yo you maxed my token capacity 🧠 That prompt was a lot. 60 seconds and I'm back."
          }
        } catch { /* keep default */ }
        return new Response(
          JSON.stringify({ message: msg }),
          { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
        )
      }
      // 503/500 = overloaded — return friendly message immediately (no retry loop)
      if (geminiRes.status === 503 || geminiRes.status === 500 || geminiRes.status === 529) {
        return new Response(
          JSON.stringify({ message: "Gemini is slammed right now 🧊 Give it 30 seconds and try again." }),
          { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
        )
      }
      throw new Error(`Gemini error: ${geminiRes.status}`)
    }

    const geminiData = await geminiRes.json()
    const aiMessage  = geminiData.candidates?.[0]?.content?.parts?.[0]?.text

    if (!aiMessage) {
      return new Response(
        JSON.stringify({ message: "Signal dropped. Hit me again and I'll be right there. 🎬" }),
        { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
      )
    }

    // Fire-and-forget memory update
    if (hashedUserId && supabase) {
      const nextRefCount = Math.min((userMemory?.memory_reference_count || 0) + 1, MAX_MEMORY_REFS + 1)
      updateUserMemory(supabase, hashedUserId, userPrompt, aiMessage, userMemory || {}, apiKey, nextRefCount)
        .catch(e => console.error('[FlickScient] Memory update failed:', e))
    }

    return new Response(
      JSON.stringify({ message: aiMessage }),
      { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    )

  } catch (error: any) {
    console.error('[FlickScient] Fatal error:', error.message)
    return new Response(
      JSON.stringify({ message: "Something broke on my end 🛠️ Try again in a sec." }),
      { headers: { ...corsHeaders, 'Content-Type': 'application/json' } }
    )
  }
})

// ─── Background Memory Updater ────────────────────────────────────────────────
async function updateUserMemory(
  supabase      : any,
  hashedUserId  : string,
  userMessage   : string,
  aiResponse    : string,
  existingMemory: UserMemory,
  apiKey        : string,
  memoryRefCount: number
) {
  const extractionPrompt = buildExtractionPrompt(userMessage, aiResponse, existingMemory)

  const controller = new AbortController()
  const timeoutId  = setTimeout(() => controller.abort(), 15000)

  try {
    const extractRes = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash-latest:generateContent?key=${apiKey}`,
      {
        method : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body   : JSON.stringify({
          contents        : [{ parts: [{ text: extractionPrompt }] }],
          generationConfig: { temperature: 0.1, maxOutputTokens: 600 },
        }),
        signal: controller.signal,
      }
    )

    clearTimeout(timeoutId)
    if (!extractRes.ok) return

    const extractData = await extractRes.json()
    const rawText     = extractData.candidates?.[0]?.content?.parts?.[0]?.text
    if (!rawText) return

    const jsonMatch = rawText.match(/\{[\s\S]*\}/)
    if (!jsonMatch) return

    const extracted = safeJsonParse(jsonMatch[0], null)
    if (!extracted?.updated_taste_profile) return

    const mergedTaste = mergeTasteProfiles(existingMemory.taste_profile, extracted.updated_taste_profile)

    const upsertPayload: Record<string, any> = {
      user_id_hash          : hashedUserId,
      taste_profile         : mergedTaste,
      conversation_summary  : extracted.updated_summary || existingMemory.conversation_summary,
      updated_at            : new Date().toISOString(),
      memory_reference_count: memoryRefCount,
    }

    if (extracted.detected_name && !existingMemory.name) {
      upsertPayload.name = extracted.detected_name
    }

    if (Math.random() < MAX_NAME_FREQUENCY) {
      upsertPayload.last_name_used_at = Date.now()
    }

    const { error: upsertError } = await supabase
      .from('flickscient_users')
      .upsert(upsertPayload, { onConflict: 'user_id_hash' })

    if (upsertError) {
      console.error('[FlickScient] Upsert failed:', upsertError.message)
    } else {
      console.log('[FlickScient] Memory updated for:', hashedUserId)
    }

  } catch (e: any) {
    clearTimeout(timeoutId)
    if (e.name !== 'AbortError') console.error('[FlickScient] Memory error:', e)
  }
}
