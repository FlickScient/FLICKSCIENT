}

const REQUEST_TIMEOUT    = 25000  // 25s — Gemini hard limit ~30s
const MAX_NAME_FREQUENCY = 0.10   // 10% chance of using name per response
const NAME_COOLDOWN_MS   = 300000 // 5 min minimum between name uses
const MAX_MEMORY_REFS    = 2      // Max past references per response

// ─── Types ────────────────────────────────────────────────────────────────────
interface TasteProfile {
  favorite_genres?   : string[]
  loved_movies?      : string[]
  disliked_movies?   : string[]
  favorite_directors?: string[]
  favorite_actors?   : string[]
  favorite_composers?: string[]
  mood_patterns?     : string[]
  viewing_style?     : string
